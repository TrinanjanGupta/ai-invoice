# Application Settings
APP_NAME=Invoice Digitizer
APP_ENV=development
SECRET_KEY=change-me

# Storage & Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/invoice_db
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invoices
MINIO_SECURE=false

# LLM Fallback (Ollama)
# Set ENABLE_LLM_FALLBACK=false to disable LLM fallback and run 100% on fast local models (LayoutLMv3 + YOLO + Regex Heuristics + Spatial OCR)
ENABLE_LLM_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434
# Recommended fast models for low-spec/CPU hardware: 'llama3.2:3b', 'llama3.2:1b', 'qwen2.5:1.5b', or 'phi3:mini'
# Default specialized model: 'invoice-expert'
OLLAMA_MODEL=invoice-expert
OLLAMA_TIMEOUT=60.0
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=15m
ENABLE_VISION_FALLBACK=false

# Extraction & OCR
OCR_LANGUAGES=en,hi,bn,ta,te,gu,mr
CONFIDENCE_THRESHOLD=0.80
LLM_FALLBACK_THRESHOLD=0.60
MAX_FILE_SIZE_MB=50

# Application
APP_NAME=Invoice Digitizer
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key-32chars

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/invoice_db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# MinIO (object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invoices
MINIO_SECURE=false

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ML Model paths
YOLO_MODEL_PATH=data/models/invoice_yolo.pt
LAYOUTLM_MODEL_PATH=data/models/layoutlmv3-finetuned
LAYOUTLM_BASE_MODEL=microsoft/layoutlmv3-base

# Pipeline settings
OCR_LANGUAGES=en,hi,bn
CONFIDENCE_THRESHOLD=0.80
LLM_FALLBACK_THRESHOLD=0.60
MAX_FILE_SIZE_MB=50
SUPPORTED_FORMATS=pdf,jpg,jpeg,png,tiff,webp

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
